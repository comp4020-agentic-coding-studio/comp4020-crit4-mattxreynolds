---
import Layout from "../layouts/Layout.astro";
import { STEP_COUNT } from "../scripts/grid";
import { PAD_DEFS } from "../scripts/pad-defs";
---

<Layout
  title="COMP4020 prototype"
  description="Replace this with one sentence saying what this page is. A search result and a link preview both show it."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>COMP4020 prototype</h1>
    <p data-testid="intro">
      Replace this with your prototype. This week's brief is on the course
      website; <code>spec/README.md</code> explains how the checks in this repo
      relate to it.
    </p>

    <section id="transport" aria-label="Transport controls">
      <button type="button" id="play-stop" aria-pressed="false">Play</button>
      <button type="button" id="clear">Clear</button>
      <button type="button" id="random-groove">Random groove</button>
      <span class="bpm-control">
        <label for="bpm">BPM</label>
        <input type="range" id="bpm" min="60" max="180" step="1" value="120" />
        <output id="bpm-value" for="bpm">120</output>
      </span>
    </section>

    <section id="pads" aria-label="Drum pads">
      {
        PAD_DEFS.map((pad) => (
          <button
            type="button"
            class="pad"
            data-pad={pad.id}
            aria-label={`${pad.label} drum — key ${pad.key}`}
            aria-pressed="false"
          >
            <span class="pad-name">{pad.label}</span>
            <span class="pad-key" aria-hidden="true">
              {pad.key}
            </span>
          </button>
        ))
      }
    </section>

    <section id="grid" aria-label="Step sequencer grid">
      {
        PAD_DEFS.map((pad) => (
          <div class="grid-row" data-pad={pad.id}>
            <span class="grid-row-label">{pad.label}</span>
            <div class="grid-steps">
              {Array.from({ length: STEP_COUNT }).map((_, step) => (
                <button
                  type="button"
                  class="step"
                  data-pad={pad.id}
                  data-step={step}
                  aria-pressed="false"
                  aria-label={`${pad.label} step ${step + 1}`}
                />
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </main>
  <section id="ambient" aria-label="Ambient layer controls"></section>
  <script src="../scripts/main.ts"></script>
</Layout>
