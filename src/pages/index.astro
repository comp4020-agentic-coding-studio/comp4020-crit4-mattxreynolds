---
import Layout from "../layouts/Layout.astro";
import { STEP_COUNT } from "../scripts/grid";
import { PAD_DEFS } from "../scripts/pad-defs";
---

<Layout
  title="Driftbeat — synth drum machine"
  description="Driftbeat: a four-pad synth drum machine with a 16-step sequencer and an ambient layer whose stereo pan never sits still."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Driftbeat</h1>
    <p class="tagline">Four drum voices, one endless drift.</p>

    <section id="transport" aria-label="Transport controls">
      <button type="button" id="play-stop" aria-pressed="false">Play</button>
      <button type="button" id="rec" aria-pressed="false" aria-label="Arm recording">REC</button>
      <button type="button" id="clear">Clear</button>
      <button type="button" id="random-groove">Random groove</button>
      <span class="bpm-control">
        <label for="bpm">BPM</label>
        <input type="range" id="bpm" min="60" max="180" step="1" value="120" />
        <output id="bpm-value" for="bpm">120</output>
      </span>
    </section>

    <section id="pads" aria-label="Drum pads">
      {
        PAD_DEFS.map((pad) => (
          <button
            type="button"
            class="pad"
            data-pad={pad.id}
            aria-label={`${pad.label} drum — key ${pad.key}`}
            aria-pressed="false"
          >
            <span class="pad-name">{pad.label}</span>
            <span class="pad-key" aria-hidden="true">
              {pad.key}
            </span>
          </button>
        ))
      }
    </section>

    <section id="grid" aria-label="Step sequencer grid">
      {
        PAD_DEFS.map((pad) => (
          <div class="grid-row" data-pad={pad.id}>
            <span class="grid-row-label">{pad.label}</span>
            <div class="grid-steps">
              {Array.from({ length: STEP_COUNT }).map((_, step) => (
                <button
                  type="button"
                  class="step"
                  data-pad={pad.id}
                  data-step={step}
                  aria-pressed="false"
                  aria-label={`${pad.label} step ${step + 1}`}
                />
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </main>
  <section id="ambient" aria-label="Ambient layer controls">
    <button type="button" id="ambient-toggle" aria-pressed="false">Ambient: Off</button>
    <div
      id="ambient-xy"
      class="ambient-xy"
      role="group"
      tabindex="0"
      aria-label="Ambient sweep speed and brightness — drag to adjust"
    >
      <div class="ambient-xy-thumb" aria-hidden="true"></div>
    </div>
    <span class="ambient-intensity">
      <label for="ambient-intensity">Intensity</label>
      <input type="range" id="ambient-intensity" min="0" max="100" step="1" value="50" />
    </span>
  </section>
  <script src="../scripts/main.ts"></script>
</Layout>
